---
import { profileConfig } from "@/config/profileConfig";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
---

<MainGridLayout title="关于我" description="About Me">
    <div class="about-page">
        <section class="section">
            <h1 class="page-title">关于我 / About Me</h1>
            <p class="intro">
                你好！我是 <strong>Silas若虚生</strong>，一个正在学习 Python（爬虫 / 运维 / 数据处理方向）的技术爱好者，喜欢折腾各种有趣的东西。
            </p>
        </section>

        <section class="section">
            <h2 class="section-title">🎯 我在做什么</h2>
            <ul class="contact-list">
                <li>📚 系统学习 Python，目标是成为能独立接单的开发者</li>
                <li>🔧 折腾爬虫、运维、数据处理相关的项目</li>
                <li>🎵 偶尔分享喜欢的音乐（博客右下角有歌单哦）</li>
            </ul>
        </section>

        <section class="section">
            <h2 class="section-title">📫 联系方式</h2>
            <p>如果你想和我交流技术问题、分享有趣的想法，或者只是想打个招呼，欢迎通过以下方式联系我：</p>
            <ul class="contact-list">
                <li>💻 <strong>GitHub</strong>: <a href="https://github.com/Silas-opy" target="_blank">Silas-opy</a></li>
                <li>✉️ <strong>Email</strong>: <a href="mailto:3450717842@qq.com">3450717842@qq.com</a></li>
                <li>🐧 <strong>QQ</strong>: 3450717842</li>
                <li>💬 <strong>微信</strong>: xmzxmz963852</li>
            </ul>
        </section>

        <section class="section">
            <h2 class="section-title">🛠️ 关于本站</h2>
            <p>
                这个网站使用 <strong>Astro</strong> 框架构建，基于 <a href="https://github.com/CuteLeaf/Firefly" target="_blank">Firefly</a> 模板（Firefly 是基于 <a href="https://github.com/saicaca/fuwari" target="_blank">Fuwari</a> 的二次开发）。
            </p>
            <ul class="link-list">
                <li>🏠 我的博客：<a href="https://silasrxs.top">https://silasrxs.top</a></li>
                <li>📝 Firefly 使用文档：<a href="https://docs-firefly.cuteleaf.cn" target="_blank">https://docs-firefly.cuteleaf.cn</a></li>
            </ul>
        </section>

        <div class="footer-note">
            <p>感谢你的来访！希望在这里能找到对你有用的内容！</p>
        </div>
    </div>
</MainGridLayout>

<style>
    .about-page {
        max-width: 100%;
    }

    .section {
        margin-bottom: 2.5rem;
    }

    .page-title {
        font-size: 2rem;
        font-weight: 700;
        color: var(--text-title);
        margin-bottom: 1rem;
    }

    .intro {
        font-size: 1.125rem;
        color: var(--text-content);
        line-height: 1.8;
    }

    .section-title {
        font-size: 1.5rem;
        font-weight: 600;
        color: var(--text-title);
        margin-bottom: 1rem;
        padding-bottom: 0.5rem;
        border-bottom: 2px solid var(--primary);
        display: inline-block;
    }

    .section-desc {
        color: var(--text-secondary);
        margin-bottom: 1rem;
    }

    .sub-title {
        font-size: 1.125rem;
        font-weight: 600;
        color: var(--text-title);
        margin: 1.5rem 0 1rem 0;
    }

    .link-list, .contact-list {
        list-style: none;
        padding: 0;
        margin: 1rem 0;
    }

    .link-list li, .contact-list li {
        padding: 0.5rem 0;
        color: var(--text-content);
    }

    .link-list a, .contact-list a {
        color: var(--primary);
        text-decoration: none;
    }

    .link-list a:hover, .contact-list a:hover {
        text-decoration: underline;
    }

    .footer-note {
        text-align: center;
        padding-top: 2rem;
        border-top: 1px solid var(--line-divider);
        color: var(--text-secondary);
        font-style: italic;
    }
</style>
